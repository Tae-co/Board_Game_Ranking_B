# 로컬 개발용 설정 템플릿.
# 이 파일을 application-local.properties 로 복사해서 쓴다 (그쪽은 gitignore 대상).
#
#   cp application-local.properties.example application-local.properties
#
# 그다음 `supabase start` 출력의 service_role key 를 supabase.service-role-key 에 붙여넣는다.
#
# ⚠️ ${ENV:기본값} 플레이스홀더를 쓰지 말 것.
#    application.properties가 .env.local을 import하므로, 플레이스홀더를 쓰면
#    .env.local의 운영 주소가 그대로 들어온다. 값을 직접 박아야 한다.
#    (LocalProfileGuard가 기동 시 이 규칙을 강제한다)

# DB - Supabase 로컬 (supabase start)
spring.datasource.url=jdbc:postgresql://127.0.0.1:54322/postgres
spring.datasource.username=postgres
spring.datasource.password=postgres

# Flyway가 스키마를 소유하고 Hibernate는 검증만 한다 (운영과 동일한 구조).
# 엔티티와 마이그레이션이 어긋나면 기동 시 즉시 실패 → 배포 전에 잡힌다.
spring.jpa.hibernate.ddl-auto=validate

# 스토리지 - Supabase 로컬. 이 주소가 로컬이라 운영 파일에 닿지 않는다.
supabase.url=http://127.0.0.1:54321
# supabase start 출력의 service_role key를 붙여넣을 것
supabase.service-role-key=

# 로컬 전용 서명키. 운영 JWT_SECRET과 달라야 로컬 토큰이 운영에서 안 통한다.
# LocalProfileGuard가 이 값과 일치하는지 확인한다.
jwt.secret=local-dev-only-secret-not-valid-in-production
